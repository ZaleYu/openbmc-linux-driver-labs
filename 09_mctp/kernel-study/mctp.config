# Core socket family and route/fragmentation support
CONFIG_MCTP=y

# Choose only transports present on the platform.
CONFIG_MCTP_TRANSPORT_I2C=m
CONFIG_MCTP_TRANSPORT_I3C=m
# CONFIG_MCTP_SERIAL is not set
# CONFIG_MCTP_TRANSPORT_USB is not set

# Required for MCTP over SMBus/I2C receive path.
CONFIG_I2C=y
CONFIG_I2C_SLAVE=y

# Required only when using the I3C transport.
CONFIG_I3C=y

