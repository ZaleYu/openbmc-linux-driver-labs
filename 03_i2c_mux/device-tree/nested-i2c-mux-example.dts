/dts-v1/;
/plugin/;

/* A two-level example. Confirm the actual part variants and binding schemas. */

&i2c7 {
	status = "okay";

	board_mux: i2c-mux@70 {
		compatible = "nxp,pca9548";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-mux-idle-disconnect;

		i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			board_fru: eeprom@50 {
				compatible = "atmel,24c02";
				reg = <0x50>;
				pagesize = <8>;
			};
		};

		i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			module_mux: i2c-mux@71 {
				compatible = "nxp,pca9546";
				reg = <0x71>;
				#address-cells = <1>;
				#size-cells = <0>;
				i2c-mux-idle-disconnect;

				i2c@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					module_0_sensor: sensor@48 {
						compatible = "demo,temp-sensor";
						reg = <0x48>;
					};
				};

				i2c@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;

					module_1_sensor: sensor@48 {
						compatible = "demo,temp-sensor";
						reg = <0x48>;
					};
				};
			};
		};
	};
};

