/* Two independent UART-backed LIN masters with independent schedules. */
&uart3 {
	current-speed = <19200>;
	status = "okay";
	lin-temperature-a {
		compatible = "demo,lin-temp-node";
		demo,lin-frame-id = <0x12>;
		demo,poll-interval-ms = <1000>;
	};
};

&uart4 {
	current-speed = <19200>;
	status = "okay";
	lin-temperature-b {
		compatible = "demo,lin-temp-node";
		demo,lin-frame-id = <0x13>;
		demo,poll-interval-ms = <1000>;
	};
};
